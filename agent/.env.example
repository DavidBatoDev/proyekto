APP_NAME=Roadmap AI Agent
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8010

# NestJS base API URL (include /api prefix)
NEST_API_BASE_URL=http://localhost:8001/api
# Per-call timeout for backend requests. Feeds the execute batch reserve
# (OPENAI_MODEL_TIMEOUT_SECONDS + 3 x this) which must stay under
# AGENT_RUN_HARD_DEADLINE_SECONDS, or no batch can ever start.
NEST_TIMEOUT_SECONDS=20

# OpenAI
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Loop engine + runtime (app/core/engine, app/core/runtime) — the only
# roadmap-AI brain. Every model-facing phase of a run (investigate ->
# propose -> execute -> verify) runs the same hand-rolled tool-calling loop on
# ONE model (no separate classifier); the V2 env names are kept for deploy
# compatibility. gpt-5.4-mini is the cost/quality sweet spot; gpt-5.4-nano is
# cheapest, gpt-5.4 (full) for hard cases.
# ---------------------------------------------------------------------------
OPENAI_MODEL_V2=gpt-5.4-mini
AGENT_V2_MAX_TURNS=8
# 24 fits exhaustive-read Q&A ("explain every epic in detail" = ~1 read per
# node); 14 exhausted the budget before the answer on ~8-feature roadmaps.
AGENT_V2_MAX_TOOL_CALLS=24
OPENAI_V2_MAX_OUTPUT_TOKENS=4000
OPENAI_V2_REASONING_EFFORT=low
# Omit (leave blank) for GPT-5 reasoning models — they reject non-default
# temperature. Set a float only if your configured model accepts it.
# OPENAI_V2_TEMPERATURE=
# Stream model calls so the web can render assistant text as it generates
# (via assistant_delta trace events). false = plain non-streaming calls.
OPENAI_V2_STREAMING_ENABLED=true
# Request sanitized reasoning summaries (reasoning.summary=auto) and surface
# them as assistant_thought trace events — the "thought" lines between tool
# steps in the web activity timeline. Needs an OpenAI org verified for
# reasoning summaries (self-heals to off for the process on the 400 if not).
OPENAI_V2_REASONING_SUMMARY_ENABLED=false

# Push trace events to the Cloudflare realtime worker (user:{id} rooms) so
# the web timeline updates without waiting for the next poll. Same env names
# as the NestJS backend's RealtimePublisher; unset = dormant (polling covers).
AGENT_REALTIME_TRACE_PUSH_ENABLED=false
REALTIME_WORKER_URL=
REALTIME_PUBLISH_TOKEN=

# Agent runtime settings
SESSION_TTL_SECONDS=14400
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_SESSION_KEY_PREFIX=roadmap:ai:session
MAX_OPERATIONS_PER_REQUEST=25
# Counts include structured tool-call pairs (role='assistant' with
# tool_calls + role='tool' with tool_call_id). 1 resolver call = 2
# messages; a typical edit turn produces 4-10 messages total.
MAX_CHAT_HISTORY_MESSAGES=30
# Conversation compaction: past TRIGGER messages the oldest turns beyond
# KEEP are folded into a rolling summary (computed on SUMMARY_MODEL,
# applied at the next turn start) and truncated from Redis.
AGENT_SUMMARY_MODEL=gpt-4o-mini
AGENT_SUMMARY_TRIGGER_MESSAGES=40
AGENT_SUMMARY_KEEP_MESSAGES=30
AGENT_SUMMARY_MAX_CHARS=4000

# ---------------------------------------------------------------------------
# Run orchestration (investigate -> propose -> execute -> verify). Clamped
# numbers only; the run machine has no on/off switch.
# Soft step budget: the loop stops starting new model turns past it.
AGENT_RUN_STEP_BUDGET_SECONDS=90
# Hard per-request ceiling (under the web's 180s and Cloud Run's 300s). No
# execute batch starts unless it can finish inside it (reserve =
# OPENAI_MODEL_TIMEOUT_SECONDS + 3 * NEST_TIMEOUT_SECONDS).
AGENT_RUN_HARD_DEADLINE_SECONDS=165
# Requests (message + continues) one run may consume (~24 min at 8).
AGENT_RUN_MAX_STEPS=8
# Per-session run lock TTL; >= the Cloud Run timeout so a dead request can
# never overlap a live one.
AGENT_RUN_LOCK_TTL_SECONDS=300
# Paused loop transcripts (Redis side keys) live this long.
AGENT_RUN_TRANSCRIPT_TTL_SECONDS=900
# Checkpoint policy: workspace scope auto-applies a single-roadmap,
# delete-free batch up to this many ops; anything wider is proposed first.
AGENT_DIRECT_EDIT_MAX_OPERATIONS=15
# Roadmap scope: edits to the focus roadmap auto-apply up to this many ops,
# deletes included (today's in-roadmap behaviour).
AGENT_DIRECT_EDIT_MAX_OPERATIONS_FOCUS=90
# Materialize mini loop (proposal titles -> operations, per target).
AGENT_EXECUTE_MAX_TURNS=4
AGENT_EXECUTE_MAX_TOOL_CALLS=10
# Context-cache LRU size; at most (N - 1) referenced roadmaps auto-load.
AGENT_MAX_LOADED_ROADMAPS=6
# @-references accepted per message (backend resolver takes up to 25).
AGENT_MAX_REFS_PER_MESSAGE=20
# Per-call OpenAI client timeout.
OPENAI_MODEL_TIMEOUT_SECONDS=90
# Redis-backed trace store: key prefix, TTL (re-armed on every flush), and
# the flush cadence (every N events or every INTERVAL seconds).
REDIS_TRACE_KEY_PREFIX=roadmap:ai:trace
AGENT_TRACE_TTL_SECONDS=900
AGENT_TRACE_FLUSH_EVERY_EVENTS=5
AGENT_TRACE_FLUSH_INTERVAL_SECONDS=0.5
AGENT_CACHE_TTL_SECONDS=600
AGENT_PROJECT_CONTEXT_ENABLED=true
# Knowledge pipeline (RAG). Ships dark: enable only after the backend's
# KNOWLEDGE_INGEST_ENABLED pipeline is live and backfilled.
AGENT_KNOWLEDGE_SEARCH_ENABLED=false
# Above this many memory notes, inject-all switches to per-turn top-k
# semantic retrieval (requires the knowledge pipeline for embeddings).
AGENT_MEMORY_SEMANTIC_THRESHOLD=15
# Resolve-lookup cache lives only for one message turn (the dispatcher is
# rebuilt per turn). 300 (the max) keeps a resolved node cached for the whole
# turn so long multi-tool turns don't re-hit the DB for a label they already
# resolved. Capped at 300.
AGENT_RESOLVE_CACHE_TTL_SECONDS=300
AGENT_RESOLVE_PARALLEL_VARIANTS_ENABLED=false

# Logging/tracing
AGENT_LOG_LEVEL=DEBUG
AGENT_LOG_JSON=true
AGENT_LOG_COLOR=auto
AGENT_LOG_INCLUDE_CONTENT=false
# When set, every event is written to this file in append mode. ANSI colors
# are always disabled when a file handler is attached. Leave unset (or blank)
# to log only to the terminal.
# AGENT_LOG_FILE=../logs.txt
# Disable terminal logging when AGENT_LOG_FILE is set to route output to the
# file only. Defaults to true; set to false to silence stdout/stderr.
AGENT_LOG_TO_CONSOLE=true
AGENT_PROGRESS_EVENTS_ENABLED=true
AGENT_PROGRESS_EVENTS_ALLOW_VERBOSE=true
