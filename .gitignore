*.pyc
*.env
# Claude Code: track shareable config, ignore local/runtime state
.claude/*
!.claude/settings.json
!.claude/agents/
!.claude/skills/
!.claude/commands/
!.claude/hooks/
.claude/settings.local.json
keys

# .mcp.json IS tracked: it must never contain literal tokens, only ${ENV_VAR}
# references resolved from the developer's own environment.
mcp.json

# Stock photo seeding (scripts/seed_stock_photos.mjs). Source images and the
# compressed staging output stay local — only the generated manifest at
# web/src/data/stockPhotoManifest.ts is committed.
/seed-images/
/.stock-staging/

# Downloaded Google OAuth client JSON — carries the client secret in plaintext.
# Use it with `node scripts/gmail_auth.mjs --secrets <file>` and then delete it.
client_secret*.json

# Playwright
node_modules/
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/
