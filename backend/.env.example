# NestJS Backend Environment Variables
# Production is the safe default. `npm run dev` explicitly overrides this to
# development and loads `.env.development.local` instead of this file.

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Cloudflare R2 storage (S3-compatible). File uploads/downloads use R2.
#   R2_ACCOUNT_ID         Cloudflare account id (R2 endpoint is https://<id>.r2.cloudflarestorage.com)
#   R2_ACCESS_KEY_ID/...  R2 S3 API token credentials (Object Read & Write)
#   R2_PUBLIC_BUCKET      bucket for public assets (avatars, banners, etc.)
#   R2_PRIVATE_BUCKET     bucket for private objects (identity documents)
#   R2_PUBLIC_BASE_URL    custom domain bound to the public bucket
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=proyekto-media
R2_PRIVATE_BUCKET=proyekto-private
R2_PUBLIC_BASE_URL=https://cdn.proyekto.tech

# Server Configuration
PORT=3001
NODE_ENV=production
REQUEST_TIMEOUT_MS=25000
SLOW_REQUEST_THRESHOLD_MS=1500
SUPABASE_FETCH_TIMEOUT_MS=12000
ENABLE_CLOUD_TRACE=false
CLOUD_TRACE_SAMPLE_RATIO=0.1
OTEL_SERVICE_NAME=proyekto-backend
OTEL_DEBUG_LOGS=false

# CORS
# Native Capacitor shells issue requests from capacitor://localhost (iOS) and
# http(s)://localhost (Android). Add those origins in deployed environments so
# the mobile app can call /api/push/tokens and the rest of the API.
CLIENT_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,capacitor://localhost,http://localhost,https://localhost
PUBLIC_API_URL=https://api.proyekto.tech

# ── Outbound email ────────────────────────────────────────────────────────
# One Gmail OAuth credential sends everything (invoices, invites, OTPs).
# See docs/12-runbooks/google-oauth-email.md — publish the OAuth consent
# screen to Production or the refresh token dies every ~7 days.
APP_URL=http://localhost:5173
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
# Backward-compatible aliases (if your deployment still uses these names):
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Per-purpose sender addresses. Each MUST be verified under
# Gmail → Settings → Accounts → "Send mail as" on the authenticated mailbox,
# or Gmail rejects the message. Leave blank to fall back to GMAIL_FROM_EMAIL
# and then to the authenticated mailbox identity.
MAIL_FROM_NOREPLY=
MAIL_FROM_BILLING=
MAIL_FROM_ACCOUNTS=
MAIL_FROM_SUPPORT=
MAIL_FROM_NAME=Proyekto
# Global fallback sender, and the legacy invite-only override:
GMAIL_FROM_EMAIL=
INVITE_FROM_EMAIL=

# Roadmap AI (performance/safety)
ROADMAP_AI_AUTHZ_CACHE_TTL_MS=10000
ROADMAP_AI_AUTHZ_CACHE_MAX_ENTRIES=5000
ROADMAP_AI_AUTHZ_CACHE_VERSION=v1

# HTTP cache policy tuning (seconds)
CACHE_PUBLIC_MAX_AGE_SECONDS=60
CACHE_PUBLIC_S_MAX_AGE_SECONDS=300
CACHE_PUBLIC_STALE_WHILE_REVALIDATE_SECONDS=60
CACHE_PRIVATE_MAX_AGE_SECONDS=15
CACHE_PRIVATE_STALE_WHILE_REVALIDATE_SECONDS=30

# Upstash Redis (shared for throttling + AI temp store + cache-aside)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Redis data cache tuning
REDIS_DATA_CACHE_ENABLED=true
REDIS_CACHE_PUBLIC_TTL_SECONDS=120
REDIS_CACHE_AUTH_TTL_SECONDS=45
REDIS_CACHE_DEBUG_HEADERS=false
REDIS_CACHE_MARKETPLACE_INDEX_TTL_SECONDS=86400
REDIS_CACHE_TTL_JITTER_PERCENT=10

# Cloudflare edge purge (best-effort, non-blocking)
CLOUDFLARE_PURGE_ENABLED=false
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_PURGE_API_TOKEN=
CLOUDFLARE_PURGE_TIMEOUT_MS=2500

# Realtime (Cloudflare Durable Objects) fan-out — collaborative features only.
# Leave blank to keep the publisher dormant (no-op). When both are set the
# backend POSTs events to the Worker's /publish route.
#   REALTIME_WORKER_URL    deployed Worker origin (e.g. https://proyekto-realtime.<acct>.workers.dev)
#   REALTIME_PUBLISH_TOKEN  shared secret; must match the Worker's secret
REALTIME_WORKER_URL=
REALTIME_PUBLISH_TOKEN=
REALTIME_PUBLISH_TIMEOUT_MS=3000

# Firebase Admin (FCM) push notifications for the Android/iOS apps.
# Always set the Firebase project id:
FIREBASE_PROJECT_ID=tech-proyekto-app
#
# Pick ONE auth mode (leave all blank to disable push — it becomes a safe no-op):
#
# (A) Keyless — RECOMMENDED, required when org policy blocks downloadable keys.
#     Uses Application Default Credentials: Workload Identity on Cloud Run, or
#     `gcloud auth application-default login` locally. The identity needs FCM send
#     access on the Firebase project (role roles/firebasecloudmessaging.admin).
FIREBASE_USE_ADC=true
#
# (B) Service-account key — only if your org allows key downloads. From the
#     service-account JSON (Project Settings > Service accounts > Generate key).
#     Store FIREBASE_PRIVATE_KEY as a single line with literal \n (un-escaped at
#     runtime). If both A and B are set, the key (B) wins.
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# Upper bound (ms) on the awaited FCM send inside notification creation.
PUSH_SEND_TIMEOUT_MS=1500

# Self-hosted OTA (mobile live-update) publish secret. Shared bearer token used
# by CI to presign + register web bundles via /api/mobile-updates/bundles*.
# The public check/stats endpoints work without it. Unset = publishing closed.
OTA_PUBLISH_TOKEN=

# ── Model Context Protocol (MCP) server ──────────────────────────────────────
# Master kill switch for the first-party Proyekto MCP server. Anything but
# 'true' => /mcp returns 503 and the PAT management endpoints deny.
MCP_ENABLED=
# Upper bound on rows returned by a single paginated MCP read tool (default 100).
MCP_MAX_PAGE_SIZE=

# OAuth 2.1 authorization server — a SECOND gate on top of MCP_ENABLED, so OAuth
# can ship dark while MCP itself is live. This is what lets the hosted Claude
# surfaces (claude.ai, Desktop, mobile, Cowork) connect, since they have no field
# for a Personal Access Token. Unset => the discovery documents 404, /oauth/*
# denies, and /mcp emits no WWW-Authenticate challenge.
MCP_OAUTH_ENABLED=
# HS256 signing secret for MCP access tokens (min 32 chars). Deliberately NOT the
# same value as SUPABASE_JWT_SECRET: distinct secrets are what stop an MCP access
# token from verifying as a Supabase session and vice versa. Unset => OAuth fails
# closed with 503. Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('base64url'))"
MCP_OAUTH_JWT_SECRET=
# Authorization-server issuer and protected-resource identifier. The resource MUST
# byte-match the URL a user types into their MCP host. Both default to
# PUBLIC_API_URL (+ '/mcp'); prod derives them in the deploy workflow.
MCP_OAUTH_ISSUER=
MCP_OAUTH_RESOURCE=
# Access-token lifetime in seconds (default 3600). Short by design: tokens are
# stateless, so revoking a connection kills the refresh token immediately and the
# access token dies at expiry.
MCP_OAUTH_ACCESS_TTL_SECONDS=

# Chat writes (Phase 4) — a THIRD gate, letting a connected agent post, edit, and
# unsend messages in project channels. Set to 'true' to enable. While unset, the
# chat:write scope cannot be granted, never appears in discovery or on the consent
# screen, and the chat write tools are not registered at all. Channel messages
# only: direct messages and channel administration are deliberately not exposed.
MCP_CHAT_WRITE_ENABLED=

# ─────────────────────────────────────────────────────────────────────────────
# Platform billing
# ─────────────────────────────────────────────────────────────────────────────
# Proyekto's own per-seat subscriptions, one per workspace. Named
# "platform billing" because "billing" already means contract billing period in
# the marketplace modules — money a client owes a consultant, not money a
# workspace owes Proyekto.
#
# Provider-neutral: each payment provider is an adapter configured by its own
# credentials, and billing is on wherever the active provider is configured.
# With no credentials every billing path early-returns, so nothing can reach
# the network.
#
# Which provider NEW checkouts go through (stripe | polar | paddle; default
# stripe). Existing subscriptions keep using the provider recorded on their
# row, so changing this never strands a paying workspace.
BILLING_PROVIDER=
#
# Stripe adapter. Webhook URL: POST /api/platform-billing/webhooks/stripe
STRIPE_SECRET_KEY=
# The signing secret of ONE Stripe webhook endpoint. Test mode and live mode
# need SEPARATE endpoints with separate secrets: otherwise events from the other
# mode arrive here, fail to resolve a workspace, and retry for three days.
STRIPE_WEBHOOK_SECRET=

# Price ids — not secrets (they are public in most Stripe integrations), so they
# travel as plain env vars and Secret Manager stays small.
#
# CAREFUL: /pricing shows a yearly plan as a PER-MONTH figure ("$10 per
# user/month, billed yearly"), so the yearly Price object is unit_amount 12000
# with interval 'year', NOT 1000 monthly. Wiring the monthly amount to a yearly
# price undercharges by 12x. Expected Stripe configuration:
#   Pro       monthly  1200 / month     yearly  12000 / year
#   Business  monthly  2400 / month     yearly  24000 / year
# All per_unit, licensed, USD. Enterprise is quoted and has no self-serve price.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=
STRIPE_PRICE_BUSINESS_MONTHLY=
STRIPE_PRICE_BUSINESS_YEARLY=

# The reconcile cron (POST /api/platform-billing/cron/reconcile) authenticates
# with MEETINGS_CRON_SECRET like the other cron endpoints.
# How long a request may wait for a seat-quantity push to the provider before giving up
# and leaving the row for the cron. Default 2000. Bounded rather than detached
# because Cloud Run can freeze instance CPU once the response is sent.
PLATFORM_BILLING_SEAT_SYNC_BOUND_MS=
