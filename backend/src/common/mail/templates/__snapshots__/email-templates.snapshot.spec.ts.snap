"<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice INV-2026-0001</title>
  </head>
  <body style="margin:0;padding:0;background-color:#ffffff;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Arial,sans-serif;">
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;color:transparent;">Invoice INV-2026-0001 for USD 4,200.50, due September 1, 2026</div>
    <table width="100%" cellpadding="0" cellspacing="0" role="presentation" style="background-color:#ffffff;padding:32px 16px;">
      <tr>
        <td align="center">
          <table width="560" cellpadding="0" cellspacing="0" role="presentation" style="width:560px;max-width:560px;">
            <tr>
              <td align="center" style="padding:0 0 26px;">
                <span style="color:#2563eb;font-size:22px;font-weight:700;letter-spacing:.01em;">Proyekto</span>
              </td>
            </tr>
            <tr>
              <td align="center" style="padding:0 0 26px;">
                <h1 style="margin:0;color:#0f172a;font-size:26px;line-height:1.3;font-weight:700;">Invoice INV-2026-0001</h1>
              </td>
            </tr>
            <tr>
              <td style="padding:0 0 28px;">
            <p style="margin:0 0 16px;color:#334155;font-size:15px;line-height:1.6;"><strong>&lt;script&gt;alert(1)&lt;/script&gt;</strong> has issued you an invoice.</p>
            <table cellpadding="0" cellspacing="0" role="presentation" style="margin:0 0 16px;">
              <tr>
                <td style="padding:4px 16px 4px 0;color:#64748b;font-size:15px;line-height:1.6;">Amount due</td>
                <td style="padding:4px 0;color:#0f172a;font-size:15px;line-height:1.6;font-weight:600;">USD 4,200.50</td>
              </tr>
              <tr>
                <td style="padding:4px 16px 4px 0;color:#64748b;font-size:15px;line-height:1.6;">Due date</td>
                <td style="padding:4px 0;color:#0f172a;font-size:15px;line-height:1.6;font-weight:600;">September 1, 2026</td>
              </tr>
              <tr>
                <td style="padding:4px 16px 4px 0;color:#64748b;font-size:15px;line-height:1.6;">Period covered</td>
                <td style="padding:4px 0;color:#0f172a;font-size:15px;line-height:1.6;font-weight:600;">August 1, 2026 – August 31, 2026</td>
              </tr>
            </table>
            <p style="margin:0 0 16px;color:#334155;font-size:15px;line-height:1.6;">Ask your service provider for a copy of the full invoice.</p>
              </td>
            </tr>
            <tr>
              <td style="padding:20px 0 0;border-top:1px solid #e2e8f0;">
                <p style="margin:0;color:#64748b;font-size:13px;line-height:1.6;">You received this email because an invoice was issued to you on Proyekto.</p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>"
`;

