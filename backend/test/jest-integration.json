{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".integration-spec.ts$",
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  },
  "setupFiles": [
    "<rootDir>/integration/load-env.ts"
  ],
  "testTimeout": 60000,
  "maxWorkers": 1,
  "moduleNameMapper": {
    "^htmlparser2$": "<rootDir>/../node_modules/htmlparser2/dist/commonjs/index.js"
  }
}
