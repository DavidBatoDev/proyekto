# Production web env — loaded automatically by Vite for `vite build` (production
# mode). The dev server (mode=development) ignores this file and keeps using the
# local, gitignored web/.env. These are all public VITE_ values embedded in the
# client bundle, so they are safe to commit. Committing this fixes CI/native
# builds, which otherwise fall back to http://localhost:8000 (web/src/api/axios.ts).
VITE_API_URL=https://api.proyekto.tech
VITE_SUPABASE_URL=https://byvbnkpiselvvulsvxgo.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImJ5dmJua3Bpc2VsdnZ1bHN2eGdvIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODE2Mjk4NzQsImV4cCI6MjA5NzIwNTg3NH0.OJN5nczndFL2ql28yut7XfjH3JelK7Q0inSDi-Trrok
VITE_AGENT_API_URL=https://proyekto-agent-f7ljmp3skq-as.a.run.app
VITE_REALTIME_URL=https://proyekto-realtime.lucky-mud-7121.workers.dev
VITE_AI_PROGRESS_PRESENTATION_MODE=curated


# The three below were never set on Vercel either, so the build fell through to
# the in-code defaults. They are pinned here explicitly - same resulting
# behaviour, but the value is now visible in the repo instead of being implied
# by a fallback three files away. Added during the Vercel -> Cloudflare move,
# where "which env did prod actually build with" stopped being answerable from
# a hosting dashboard.

# Upload worker origin. Matches the hardcoded fallback in
# src/services/upload.service.ts (same Worker as VITE_REALTIME_URL, which also
# hosts POST /uploads).
VITE_UPLOAD_WORKER_URL=https://proyekto-realtime.lucky-mud-7121.workers.dev

# Semantic theme runtime. Code default is ON (the flag reads `!== "false"`), so
# this changes nothing - set to false as a rollback to force Light and hide the
# appearance entry point.
VITE_THEME_SYSTEM_ENABLED=true

# Curated stock photos as roadmap thumbnails. OFF, which is what prod has always
# served - Vercel never set this, so the flag read undefined and roadmap create
# kept generating gradient thumbnails.
#
# The R2 side is READY: scripts/seed_stock_photos.mjs has run, all 128 objects
# across 8 themes are live (verified GET cdn.proyekto.tech/stock/... -> 200), so
# the safety ordering in src/config/featureFlags.ts is already satisfied.
# Flipping this to true is a deliberate, separate activation - deliberately not
# bundled into the hosting migration.
VITE_STOCK_PHOTOS_ENABLED=false
VITE_CANVAS_COMMENT_INDICATORS=true

# "Invite a team" — ask someone outside the project to bring one of their own
# teams onto it. Gates only the SEND side (the button + pending list on the
# project's Teams page); the recipient's side always renders when an invitation
# exists, so flipping this back off cannot strand anything already sent.
#
# Never set on the hosting dashboard, so prod read undefined and the button was
# hidden even though the feature shipped. Pinned true here to turn it on.
VITE_TEAM_PROJECT_INVITES=true

# Native Google sign-in (Android). The WEB OAuth client ID from Google Cloud —
# the same one Supabase's Google provider uses, and the one listed under the
# provider's "Authorized Client IDs" so signInWithIdToken is accepted.
#
# Android's Credential Manager takes the web client id, not the Android one; the
# Android OAuth client exists only so Google can verify the app's package name +
# SHA-1. Public by design, like every other value in this file.
#
# Unset => isNativeGoogleAuthAvailable() returns false and the app falls back to
# the web redirect flow, so a missing value degrades instead of breaking.
VITE_GOOGLE_WEB_CLIENT_ID=177334028893-1illkkrp182fd3fqpe9b5v1kocb5uln1.apps.googleusercontent.com
